# Environment: "development" or "production"
ENVIRONMENT=production

# Secret key for JWT (generate with: python -c "import secrets; print(secrets.token_urlsafe(32))")
SECRET_KEY=change-me-to-a-strong-random-key

# Database - Supabase PostgreSQL connection string
# Find this in Supabase Dashboard > Settings > Database > Connection string (URI)
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# AI Provider: "openai", "gemini", or "ollama"
AI_PROVIDER=gemini

# API Keys (set the ones you use)
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Ollama (only if using local models)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_HEBREW_MODEL=aya-expanse:32b-q4_K_M
OLLAMA_REASONING_MODEL=qwen2.5:72b-instruct-q4_K_M

# CORS - comma-separated list of allowed origins
BACKEND_CORS_ORIGINS=https://your-app.netlify.app,http://localhost:7001
